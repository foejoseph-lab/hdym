# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# C kernels are compiled into a temporary directory by the scripts; ignore any built in place
*.so
*.dll
*.o

# LaTeX build products (paper/ only: *.log elsewhere are committed run logs)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc

# PNG copies the figure scripts write next to the PDFs the paper includes
paper/*.png

# results_percomp.7z is committed; its unpacked copy is not
ym/data/results_percomp/

